# Lexora Server Environment Variables
# Copy this file to .env and fill in the values

# MySQL
DB_URL=jdbc:mysql://localhost:3306/dictionary?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=change-me

# Auth (JWT)
# Must be at least 32 bytes. Example: `openssl rand -hex 32`
APP_AUTH_JWT_SECRET=replace-with-a-random-64-hex-char-secret
APP_AUTH_ACCESS_TOKEN_TTL_SECONDS=900
APP_AUTH_REFRESH_TOKEN_TTL_SECONDS=2592000

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# LLM provider credentials
# Provider topology lives in config/application.yml.example.
DEEPSEEK_API_KEY=
BAILIAN_API_KEY=
TENCENT_API_KEY=
ANTHROPIC_API_KEY=

# TTS Provider selection: qwen3 | tencent | mimo
TTS_PROVIDER=qwen3

# Qwen3-TTS
# When dicserver runs in Docker and Qwen3 runs on the host, use host.docker.internal
TTS_BASE_URL=http://host.docker.internal:8000
TTS_API_KEY=
TTS_SPEAKER=vivian
AUDIO_GENERATION_SCHEDULER_WINDOW_START=00:00
AUDIO_GENERATION_SCHEDULER_WINDOW_END=02:00
AUDIO_GENERATION_SCHEDULER_TICK_SECONDS=300
AUDIO_GENERATION_SCHEDULER_ZONE_ID=Asia/Shanghai

# Tencent Cloud TTS (optional)
TENCENT_TTS_SECRET_ID=
TENCENT_TTS_SECRET_KEY=
TENCENT_TTS_APP_ID=
TENCENT_TTS_VOICE_TYPE=502001
TENCENT_TTS_EMOTION=story

# Xiaomi MiMo TTS (optional, OpenAI Chat Completions compatible)
# Set TTS_PROVIDER=mimo and MIMO_TTS_API_KEY to activate. English voices: Mia, Chloe, Milo, Dean
MIMO_TTS_BASE_URL=https://api.xiaomimimo.com/v1
MIMO_TTS_API_KEY=
MIMO_TTS_MODEL=mimo-v2.5-tts
MIMO_TTS_VOICE=Mia
MIMO_TTS_FORMAT=mp3

# Audio Storage
AUDIO_STORAGE_DIR=./audio-data

# Search History Cleanup (days)
CLEANUP_SEARCH_HISTORY_RETENTION_DAYS=90
